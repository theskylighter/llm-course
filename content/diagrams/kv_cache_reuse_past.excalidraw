  "files": {},
  "metadata": {
    "title": "KV cache reuses the past; compute only the new token",
    "description": "During causal decoding, previous keys and values do not change, so the KV cache stores them and only the new token projections are computed. This removes repeated matrix projections, but attention still reads the cached history and cache memory grows with sequence length."
  }
}
