  "files": {},
  "metadata": {
    "title": "BART reconstructs whole text; T5 reconstructs masked spans",
    "description": "BART corrupts an input and trains its encoder-decoder to reconstruct the entire clean sequence. T5 replaces spans with unique sentinel tokens and trains the decoder to output only the missing spans."
  }
}
