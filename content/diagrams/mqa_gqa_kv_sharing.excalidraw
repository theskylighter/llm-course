  "metadata": {
    "title": "MQA and GQA share K/V heads to shrink the cache",
    "description": "Multi-query attention keeps all query heads but shares one key/value head; grouped-query attention shares one key/value head per group. Cache size scales with the number of K/V heads G relative to query heads h; only W_K and W_V shrink."
  }
