  "files": {},
  "metadata": {
    "title": "ELMo gives a word a vector from its context",
    "description": "A static embedding gives the same vector to both uses of bat. ELMo runs a frozen forward and backward LSTM over the sentence, then learns task-specific weights over layer states to produce a contextual token vector. ELMo is LSTM-based, not a Transformer."
  }
}
