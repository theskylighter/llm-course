  "metadata": {
    "title": "Inside the original encoder–decoder Transformer",
    "description": "Source tokens pass through bidirectional encoder layers to form memory. Shifted target tokens pass through causal decoder self-attention, cross-attention to encoder memory, and feed-forward layers before a linear softmax predicts the next token."
  }
