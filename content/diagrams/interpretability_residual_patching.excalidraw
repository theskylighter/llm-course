  "files": {},
  "metadata": {
    "title": "Interpretability: what the network reads and writes",
    "description": "The residual stream is a running sum written by attention and feed-forward blocks. QK circuits read by scoring token pairs; OV circuits write information. Activation patching copies a clean activation into a corrupted run and measures normalized restoration as causal evidence."
  }
}
