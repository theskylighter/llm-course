  "files": {},
  "metadata": {
    "title": "Model editing: change one fact, protect the rest",
    "description": "Model editing changes a targeted fact without retraining. KnowledgeEditor predicts a parameter update under a KL locality constraint, ROME writes a rank-one association into a mid-layer MLP, and IKE places the new fact in the prompt. Evaluate efficacy, generalization, and locality."
  }
}
