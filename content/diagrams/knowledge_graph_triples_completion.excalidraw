  "files": {},
  "metadata": {
    "title": "Knowledge graphs make facts explicit and queryable",
    "description": "Knowledge graphs store subject-relation-object triples and support exact multi-hop joins. Link prediction scores candidate triples (TransE uses low distance between s+r and o). Retrieved subgraphs can ground LLM answers, but knowledge graphs are incomplete."
  }
}
